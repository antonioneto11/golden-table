{
  "name": "golden-table-simulator",
  "version": "0.1.0",
  "scripts": {
    "test": "vitest run",
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run build && node e2e/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonioneto11/golden-table.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/antonioneto11/golden-table/issues"
  },
  "homepage": "https://github.com/antonioneto11/golden-table#readme",
  "private": "true",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
